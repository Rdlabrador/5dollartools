<Project Sdk="Microsoft.NET.Sdk">

  <!-- Programa de Mac de PepePDF: ventana Photino (WKWebView) + la biblioteca común. Se publica con -r osx-arm64 / osx-x64. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PepePDF</AssemblyName>
    <Product>PepePDF</Product>
    <Title>PepePDF</Title>
    <RootNamespace>FirmarPdf</RootNamespace>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\comun\PepePDF.Comun.csproj" />
    <!-- Scripts (.js / .applescript) que usa PlataformaMac.Servicios.cs -->
    <EmbeddedResource Include="scripts\**" />
  </ItemGroup>

</Project>
