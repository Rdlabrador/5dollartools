<Project Sdk="Microsoft.NET.Sdk">

  <!-- Biblioteca común de PepePDF: sin dependencias de Windows. La usan el programa de Windows y (después) el de Mac. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PepePDF.Comun</AssemblyName>
    <RootNamespace>FirmarPdf</RootNamespace>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
